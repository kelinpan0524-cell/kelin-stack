    { "pattern": "skills/*/tests/**", "feature": "unit-tests", "verify": "node --test" },
    { "pattern": "agents/**", "feature": "agents", "verify": "agents-check + CLI catalog" },
    { "pattern": "evals/**", "feature": "evals", "verify": "skill-eval 触发检查" }
