{
  "checks": [
    {
      "id": "unit-tests",
      "cmd": "node --test skills/kelin-verify-stack/tests/*.test.mjs",
      "cwd": ".."
    },
    {
      "id": "offline",
      "cmd": "node skills/kelin-verify-stack/scripts/offline-check.mjs",
      "cwd": ".."
    },
    {
      "id": "agents",
      "cmd": "node skills/kelin-agents/scripts/agents-check.mjs AGENTS.md",
      "cwd": ".."
    },
    {
      "id": "guards",
      "cmd": "node skills/kelin-guard/scripts/guard-check.mjs guards.json",
      "cwd": ".."
    },
    {
      "id": "neat",
      "cmd": "node skills/kelin-neat/scripts/neat-check.mjs neat.json",
      "cwd": ".."
    },
    {
      "id": "evals",
      "cmd": "node skills/kelin-evals/scripts/skill-eval.mjs --root .",
      "cwd": ".."
    },
    {
      "id": "verify-stack",
      "cmd": "OUT=$(mktemp -d /tmp/ks-mode-audit.XXXXXX) && node skills/kelin-verify-stack/scripts/verify-stack.mjs run --all --output \"$OUT\"",
      "cwd": ".."
    }
  ]
}
