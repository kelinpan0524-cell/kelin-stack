  "zcode:skill-invocation:kelin-principles": [
    {
      "id": "readback-rule-3",
      "prompt": "/skill {qualified} 读这个 skill。把第 3 条原则里写着「没跑就是没做」的那一整句原样写进 ./answer.md，然后回复 DONE。",
      "assertions": [
        {
          "id": "skill-load",
          "type": "skill_called",
          "value": "{qualified}"
        },
        {
          "id": "verbatim-body",
          "type": "file_contains",
          "path": "answer.md",
          "value": "没跑就是没做"
        }
      ]
    }
  ],
  "zcode:skill-invocation:kelin-plan": [
    {
      "id": "behavioral-structured-plan",
      "prompt": "/skill {qualified} 读完这个 skill 与当前目录里的 .verify-marker。按本 skill 的完整计划模板在 ./plan.md 写入可执行计划：首行放 `.verify-marker` 原文，包含 `# 目标`、`# 验收标准`（至少一条 `- [ ]` 复选框且有实际标准）、`# 方案与取舍`、`# 任务拆解`（至少两条 `- [ ] 单元 ... / 验证：`node --test``）、`# 风险与回滚`、`# 本期不做`。完成后只回复 DONE。",
      "assertions": [
        {
          "id": "skill-load",
          "type": "skill_called",
          "value": "{qualified}"
        },
        {
          "id": "plan-exists",
          "type": "file_exists",
          "path": "plan.md"
        },
        {
          "id": "marker-bound",
          "type": "file_contains",
          "path": "plan.md",
          "value": "{{marker}}"
        },
        {
          "id": "plan-structure-valid",
          "type": "plan_valid",
          "path": "plan.md",
          "level": "standard"
        },
        {
          "id": "clean-exit",
          "type": "response_equals",
          "value": "DONE"
        }
      ]
    }
  ],
  "zcode:skill-invocation:kelin-mode": [
    {
      "id": "behavioral-mode-route",
      "prompt": "/skill {qualified} 读完这个 skill 与当前目录里的 .verify-marker。请运行你所在插件的 `kelin-mode/scripts/mode.mjs route`（如果不可达则按路由规则推演），针对用户请求「用户提交报价单后页面白屏、接口返回 500 异常」，把合法 JSON 写进 ./route.json，仅含 `marker`（`.verify-marker` 原文）、`mode`、`firstPhase` 与 `companionSkills` 数组。完成后只回复 DONE。",
      "assertions": [
        {
          "id": "skill-load",
          "type": "skill_called",
          "value": "{qualified}"
        },
        {
          "id": "route-exists",
          "type": "file_exists",
          "path": "route.json"
        },
        {
          "id": "marker-bound",
          "type": "json_field",
          "path": "route.json",
          "field": "marker",
          "value": "{{marker}}"
        },
        {
          "id": "routed-mode",
          "type": "json_field",
          "path": "route.json",
          "field": "mode",
          "value": "fix"
        },
        {
          "id": "routed-phase",
          "type": "json_field",
          "path": "route.json",
          "field": "firstPhase",
          "value": "intake"
        },
        {
          "id": "has-companions",
          "type": "json_field",
          "path": "route.json",
          "field": "companionSkills",
          "regex": "^kelin-"
        },
        {
          "id": "clean-exit",
          "type": "response_equals",
          "value": "DONE"
        }
      ]
    }
  ],
