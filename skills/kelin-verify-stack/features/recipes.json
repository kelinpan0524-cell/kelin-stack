  "zcode:skill-invocation:kelin-review": [
    {
      "id": "behavioral-review-finding",
      "prompt": "/skill {qualified} 读完这个 skill 与 .verify-marker。按本 skill 的发现格式，针对未记录日志且直接吞掉错误的空 catch（位置 `src/auth.js:12`）写一条包含 `.verify-marker` 原文的审查意见到 ./review.md，必须写明 严重度（按 P0-P3 分级）、位置、触发条件、后果 和 最小改法。完成后只回复 DONE。",
      "assertions": [
        {
          "id": "skill-load",
          "type": "skill_called",
          "value": "{qualified}"
        },
        {
          "id": "review-exists",
          "type": "file_exists",
          "path": "review.md"
        },
        {
          "id": "marker-bound",
          "type": "file_contains",
          "path": "review.md",
          "value": "{{marker}}"
        },
        {
          "id": "has-location",
          "type": "file_contains",
          "path": "review.md",
          "value": "src/auth.js:12"
        },
        {
          "id": "has-severity",
          "type": "file_regex",
          "path": "review.md",
          "value": "\\bP[0-3]\\b"
        },
        {
          "id": "has-trigger",
          "type": "file_regex",
          "path": "review.md",
          "value": "触发(?:条件)?[:：]?\\s*\\S+"
        },
        {
          "id": "has-consequence",
          "type": "file_regex",
          "path": "review.md",
          "value": "后果[:：]?\\s*\\S+"
        },
        {
          "id": "has-fix",
          "type": "file_regex",
          "path": "review.md",
          "value": "改法[:：]?\\s*\\S+"
        },
        {
          "id": "clean-exit",
          "type": "response_equals",
          "value": "DONE"
        }
      ]
    }
  ]
