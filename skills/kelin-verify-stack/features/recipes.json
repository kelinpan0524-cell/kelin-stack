  "zcode:skill-invocation:kelin-plan": [
    {
      "id": "behavioral-structured-plan",
      "prompt": "/skill {qualified} 读完这个 skill 与当前目录里的 .verify-marker。按本 skill 的格式写一份最小规划到 ./plan.md：第一行写 `.verify-marker` 的原文，并包含 `## 目标`、`## 验收标准`、`## 单元`（至少一条 `- verify:` 验证命令）。完成后只回复 DONE。",
      "assertions": [
        {
          "id": "skill-load",
          "type": "skill_called",
          "value": "{qualified}"
        },
        {
          "id": "plan-exists",
          "type": "file_exists",
          "path": "plan.md"
        },
        {
          "id": "marker-bound",
          "type": "file_contains",
          "path": "plan.md",
          "value": "{{marker}}"
        },
        {
          "id": "has-acceptance-section",
          "type": "file_contains",
          "path": "plan.md",
          "value": "## 验收标准"
        },
        {
          "id": "has-verify-line",
          "type": "file_contains",
          "path": "plan.md",
          "value": "- verify:"
        },
        {
          "id": "clean-exit",
          "type": "response_equals",
          "value": "DONE"
        }
      ]
    }
  ],
